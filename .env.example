# Neon Postgres connection string.
# Neon dashboard -> your project -> Connect -> copy the "Connection string" (pooled is fine).
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Secret used to encrypt the session cookie. Must be at least 32 characters.
# Generate one with:  node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
NUXT_SESSION_PASSWORD=""
